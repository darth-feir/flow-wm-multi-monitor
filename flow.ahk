#Requires AutoHotkey v2.0.2
#SingleInstance Force

; ════════════════════════════════════════════════════════════════════════════
; FlowWM — flow.ahk
; Ready-to-use AutoHotkey v2 keybindings for FlowWM.
; ════════════════════════════════════════════════════════════════════════════
;
; Generated by:  `flow config init --ahk`
; Written to:    %USERPROFILE%\.config\flow\flow.ahk
;
; This file is yours. Edit it freely — FlowWM never overwrites it once it
; exists. Two things you may want to customise (both at the top of the file):
;
;   1. ModKey    — the modifier every binding is held with. Alt is the default
;                 (it's on every keyboard and matches other Windows tiling
;                 managers), but Alt+<letter> can collide with an app's menu
;                 shortcuts. To switch, change the one line below, e.g.
;                 ModKey := "ScrollLock", "CapsLock", "F13", or "LWin".
;                 Key list: https://www.autohotkey.com/docs/v2/KeyList.htm
;
;                 Want the Windows key? ModKey := "LWin" works, but Windows
;                 swallows some Win+<key> shortcuts (Start menu, Win+D, Win+L, …)
;                 before AutoHotkey sees them, so a few chords may misfire. The
;                 zero-compromise path: set ModKey to a sacrificial key (e.g.
;                 "ScrollLock") and hardware-remap LWin to it in your keyboard
;                 firmware — physically you press Win, the OS sees the sacrificial
;                 key. See the README's "Can I use the Win key?" section.
;
;   2. flowExe  — path to flow.exe. Defaults to "flow" (resolved from PATH).
;                 If FlowWM isn't on your PATH, set the full path, e.g.
;                 "C:\Users\you\flow.exe".
;
; Run at login:  `flow enable-autostart --ahk` (creates a single shell:startup
;                shortcut that runs `flow.exe start --ahk`; idempotent).
; Full dispatch: run `flow dispatch help` for every available command.
;
; Fail-back: every binding below is only active while the flowd daemon's named
; pipe exists. If the daemon dies, ModKey and all chords revert to stock
; Windows within one poll (2 s) — or at once, because a chord whose dispatch
; fails re-checks the daemon on the spot — and after ~10 s the script exits
; itself. A pipe that stays busy for 5 consecutive polls (a wedged daemon)
; counts as down too. At startup the script refuses to hook anything unless
; the daemon answers within 10 s.
;
; Layout (hold ModKey + key):
;   h j k l  focus left/down/up/right          (+Shift = move window)
;                                             (+Ctrl  = merge into column)
;                                             (+Ctrl+Shift = promote to new column)
;   , .      shrink / expand focused column
;   c        center viewport on focused column
;   t        cycle window float <-> tile       (+Shift = tiling on/off)
;   q        close focused window
;   p        stop the daemon (then this script exits too)
;   1..9,0   switch to workspace 1..10        (+Shift = send window there)
;   [ ]      focus monitor left / right        (+Shift = send window there)
;            (focus / move-window left/right also hop monitors at a strip edge)
;
; ════════════════════════════════════════════════════════════════════════════

; --- Config ------------------------------------------------------------------
ModKey   := "Alt"                 ; the modifier every binding is held with
flowExe := "flow"                ; path to flow.exe (PATH by default)
PipeName := EnvGet("FLOW_PIPE_NAME") || "\\.\pipe\flow"
DaemonUp := false
DownTicks := 0
BusyPolls := 0          ; consecutive polls that found the pipe busy (121)
MaxBusyPolls := 5       ; after this many, "busy" means wedged, not alive

; --- Flow command helpers ----------------------------------------------------
Flow(cmd) {
    global flowExe
    try Run('"' flowExe '" ' cmd, , 'Hide')
    catch as e
        TrayTip("could not run flow: " e.Message, "flow.ahk")
}

; Dispatch without blocking the hotkey thread (Run returns at once); the exit
; code is collected asynchronously by DispatchDone so a failed dispatch still
; re-checks the daemon right away and the next chord falls through to Windows.
FlowDispatch(cmd) {
    global flowExe
    try Run('"' flowExe '" dispatch ' cmd, , 'Hide', &pid)
    catch as e {
        TrayTip("could not run flow: " e.Message, "flow.ahk")
        return
    }
    ; PROCESS_QUERY_LIMITED_INFORMATION | SYNCHRONIZE: enough to read the exit code.
    h := DllCall("OpenProcess", "UInt", 0x1000 | 0x100000, "Int", 0, "UInt", pid, "Ptr")
    if h
        SetTimer(DispatchDone.Bind(h, 0), -50)
}

; Reap one dispatch: poll its process every 50 ms (never blocking a hotkey);
; a non-zero exit means the daemon did not answer, so the liveness check runs
; now instead of at the next 2 s tick. Gives up after ~5 s.
DispatchDone(h, polls) {
    if (DllCall("WaitForSingleObject", "Ptr", h, "UInt", 0) != 0) {   ; still running
        if (polls < 100)
            SetTimer(DispatchDone.Bind(h, polls + 1), -50)
        else
            DllCall("CloseHandle", "Ptr", h)
        return
    }
    code := 0
    DllCall("GetExitCodeProcess", "Ptr", h, "UInt*", &code)
    DllCall("CloseHandle", "Ptr", h)
    if (code != 0)
        CheckDaemon()
}

; --- Daemon liveness --------------------------------------------------------
DaemonAlive() {
    global PipeName, BusyPolls, MaxBusyPolls
    ; 1 ms wait: nonzero = an instance is free. A_LastError 2 = no such pipe
    ; (daemon gone); 121 (ERROR_SEM_TIMEOUT) = pipe exists but busy. Busy is
    ; alive only for a bounded run of polls: a wedged daemon holds the pipe
    ; busy forever, and must count as down so ModKey is released.
    if DllCall("WaitNamedPipe", "Str", PipeName, "UInt", 1) {
        BusyPolls := 0
        return true
    }
    if (A_LastError = 121)
        return ++BusyPolls <= MaxBusyPolls
    BusyPolls := 0
    return false
}

CheckDaemon() {
    global DaemonUp, DownTicks
    if DaemonAlive() {
        DaemonUp := true, DownTicks := 0
        return
    }
    DaemonUp := false            ; chords fall through to Windows immediately
    if (++DownTicks >= 5) {      ; ~10 s on the 2 s timer: release the hook
        TrayTip("FlowWM daemon is gone; " ModKey " released.", "flow.ahk")
        Sleep 1500
        ExitApp()
    }
}

; Startup gate: refuse to hook ModKey unless the daemon answers within 10 s.
Loop 20 {
    if DaemonAlive()
        break
    Sleep 500
}
if !DaemonAlive() {
    MsgBox("flow daemon not reachable at " PipeName "; not binding " ModKey " keys.", "flow.ahk", "Iconx T10")
    ExitApp()
}
DaemonUp := true
SetTimer(CheckDaemon, 2000)

; --- Action handlers ---------------------------------------------------------
; Each handler maps one ModKey+key chord to a `flow dispatch` call. The
; Ctrl/Shift variants are read at fire-time so a single key covers several
; related actions.
Act_Stop(*) {
    Flow("stop")
    ExitApp()
}

Act_Left(*) {     ; h
    if GetKeyState("Control") and GetKeyState("Shift")
        FlowDispatch("promote left")
    else if GetKeyState("Shift")
        FlowDispatch("move-window left")
    else if GetKeyState("Control")
        FlowDispatch("merge-column left")
    else
        FlowDispatch("focus left")
}

Act_Right(*) {    ; l
    if GetKeyState("Control") and GetKeyState("Shift")
        FlowDispatch("promote right")
    else if GetKeyState("Shift")
        FlowDispatch("move-window right")
    else if GetKeyState("Control")
        FlowDispatch("merge-column right")
    else
        FlowDispatch("focus right")
}

Act_Down(*) {     ; j
    if GetKeyState("Shift")
        FlowDispatch("move-window down")
    else
        FlowDispatch("focus down")
}

Act_Up(*) {       ; k
    if GetKeyState("Shift")
        FlowDispatch("move-window up")
    else
        FlowDispatch("focus up")
}

Act_Tile(*) {     ; t
    ; Shift: pause / resume tiling without stopping the daemon (every window
    ; is put back on-screen while it is off; this script keeps running, so
    ; the same chord turns it back on). Plain: float <-> tile the window.
    if GetKeyState("Shift")
        FlowDispatch("tiling toggle")
    else
        FlowDispatch("set-window cycle")
}

Act_MonitorLeft(*) {   ; [
    if GetKeyState("Shift")
        FlowDispatch("move-to-monitor left")
    else
        FlowDispatch("focus-monitor left")
}

Act_MonitorRight(*) {  ; ]
    if GetKeyState("Shift")
        FlowDispatch("move-to-monitor right")
    else
        FlowDispatch("focus-monitor right")
}

WorkspaceAction(n) {
    if GetKeyState("Shift")
        FlowDispatch("move-to-workspace " n)
    else
        FlowDispatch("switch-workspace " n)
}

; --- Register every binding --------------------------------------------------
; Done dynamically so ModKey is one changeable line: swap the modifier above and
; every chord below follows. Custom combos (e.g. "Alt & h") are passed
; to Hotkey() as a single string built from ModKey. Every registration is
; conditional on DaemonUp (see CheckDaemon): with the daemon gone the chords
; are inert and the keys behave as stock Windows again.
HotIf((*) => DaemonUp)          ; criterion for the Hotkey() registrations below
Hotkey(ModKey " & p", Act_Stop)
Hotkey(ModKey " & h", Act_Left)
Hotkey(ModKey " & l", Act_Right)
Hotkey(ModKey " & j", Act_Down)
Hotkey(ModKey " & k", Act_Up)
Hotkey(ModKey " & ,", (*) => FlowDispatch("shrink-column"))
Hotkey(ModKey " & .", (*) => FlowDispatch("expand-column"))
Hotkey(ModKey " & c", (*) => FlowDispatch("center"))
Hotkey(ModKey " & t", Act_Tile)
Hotkey(ModKey " & q", (*) => FlowDispatch("close-window"))
Hotkey(ModKey " & 1", (*) => WorkspaceAction(1))
Hotkey(ModKey " & 2", (*) => WorkspaceAction(2))
Hotkey(ModKey " & 3", (*) => WorkspaceAction(3))
Hotkey(ModKey " & 4", (*) => WorkspaceAction(4))
Hotkey(ModKey " & 5", (*) => WorkspaceAction(5))
Hotkey(ModKey " & 6", (*) => WorkspaceAction(6))
Hotkey(ModKey " & 7", (*) => WorkspaceAction(7))
Hotkey(ModKey " & 8", (*) => WorkspaceAction(8))
Hotkey(ModKey " & 9", (*) => WorkspaceAction(9))
Hotkey(ModKey " & 0", (*) => WorkspaceAction(10))
Hotkey(ModKey " & [", Act_MonitorLeft)
Hotkey(ModKey " & ]", Act_MonitorRight)
