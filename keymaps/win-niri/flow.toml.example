# Daemon settings that the win-niri keymap expects. Merge into %USERPROFILE%\.config\flow\flow.toml.
#
# The keys before the first [section] are TOP-LEVEL keys: keep them above `[columns]` — a key
# written after a section header belongs to that section and is silently ignored.

# 1/3 of 1920 minus gaps is 618 px, below the stock 640 floor, so lower the floor or the 1/3
# preset is clamped to 640 (three columns then no longer fit on one 1920 screen).
min_column_width_px = 600

# Windows that are already maximized when the daemon starts (or that open maximized, or are
# maximized when tiling is turned back on) are un-maximized and tiled/floated by the rules
# instead of being ignored until restored. They are maximized again on `tiling off` / `flow stop`.
# Fullscreen windows (video, games) are never adopted. Mod+V on an ignored window adopts it
# regardless of this key.
adopt_maximized = true

# Column widths as a share of the screen. Mod+R cycles `presets` for every column on the
# focused screen; a window moved to another screen takes that screen's width.
# Two 1920x1080 screens: 1/3 is tight, 1/2 is the comfortable default, 1/1 is one column.
[columns]
presets = ["1/3", "1/2", "1/1"]
default = "1/2"

# Stacked columns (Mod+[ / Mod+] merge): at most `visible_rows` windows are shown at a time, each
# an equal share of the height; a column can hold up to `max_rows`, and Mod+Up/Down scrolls the
# rest into view. Merging into a full column moves the window past it instead.
visible_rows = 2
max_rows = 4

# Mod+Arrows and Mod+Shift+Arrows stay on the current screen even at the end of the strip;
# the other screen is reached explicitly with Mod+Ctrl+Arrows (focus) and Mod+Alt+Arrows (move).
[navigation]
edge_hop = false
