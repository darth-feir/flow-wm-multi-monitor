# Daemon settings that the win-niri keymap expects. Merge into %USERPROFILE%\.config\flow\flow.toml.
#
# The keys before the first [section] are TOP-LEVEL keys: keep them above `[columns]` — a key
# written after a section header belongs to that section and is silently ignored.

# 1/3 of 1920 minus gaps is 618 px, below the stock 640 floor, so lower the floor: a preset
# whose term falls under the floor on a screen is refused at start / reload with a message
# naming the screen (give that screen its own [[columns.screen]] rule, see below).
min_column_width_px = 600

# Windows that are already maximized when the daemon starts (or that open maximized, or are
# maximized when tiling is turned back on) are un-maximized and tiled/floated by the rules
# instead of being ignored until restored. They are maximized again on `tiling off` / `flow stop`.
# Fullscreen windows (video, games) are never adopted. Mod+V on an ignored window adopts it
# regardless of this key.
adopt_maximized = true

# Column widths as a share of the screen. Mod+R cycles `presets` on the focused screen; a window
# moved to another screen takes that screen's width. A preset is one fraction for every column
# ("1/2") or a `+` pattern of screen slots ("2/3+1/3": two columns on screen, the window you
# are in takes the first term, so write the main size first; the slots then stay put while the
# strip scrolls, and a pattern pins them, so shrink/expand are refused while one is active).
# Two 1920x1080 screens: 1/3 is tight, 2/3+1/3 makes the window you are in wide and its
# neighbour narrow, 1/2 is the comfortable default, 1/1 is one column.
[columns]
presets = ["1/3", "2/3+1/3", "1/2", "1/1"]
default = "1/2"

# A screen matched by a rule uses its own list (first match wins; the others use the list
# above). Match on `orientation` ("portrait" / "landscape"), `min_width_px` / `max_width_px`
# (work-area width) or `name` ("DISPLAY2"). A rule may set its own `min_column_width_px`,
# because the top-level floor is screen-blind: 1/2 of a 1080-wide portrait screen is 516 px.
# [[columns.screen]]
# match = { orientation = "portrait" }
# presets = ["1/2", "1/1"]
# default = "1/1"
# min_column_width_px = 500
#
# A wider screen, when you plug one in: 1/4 of 2560 is 620 px.
# [[columns.screen]]
# match = { min_width_px = 2560 }
# presets = ["1/4", "1/4+1/4+1/2", "1/4+1/2+1/4", "1/3", "1/3+2/3", "1/2", "1/1"]
# default = "1/3"

# Stacked columns (Mod+[ / Mod+] merge): at most `visible_rows` windows are shown at a time, each
# an equal share of the height; a column can hold up to `max_rows`, and Mod+Up/Down scrolls the
# rest into view. Merging into a full column moves the window past it instead.
visible_rows = 2
max_rows = 4

# Book layout: instead of parking the columns out of view off-screen, pile them behind the
# leftmost and rightmost visible columns (the edge columns are the piles' top cards). Mod+Left /
# Mod+Right flip one card, a taskbar click or Alt+Tab onto a piled window flips the book to it,
# and dropping a dragged window anywhere on a top card makes it the new top. With 1/1 the screen
# is a carousel, with 1/2 two piles, with 1/3 the middle column stays a plain window.
# Mod+Shift+B toggles the focused screen between "strip" and "book" until the next reload.
# A rule can give one screen its own layout without its own presets:
# [[columns.screen]]
# match = { name = "DISPLAY2" }
# layout = "book"
layout = "strip"
# Focus wraps from one end of the strip to the other: "off", "on" (every screen) or "book" (only
# on a screen in book layout). With wrapping, Mod+Left/Right never hops to the other screen.
wrap_around = "off"

# Mod+Arrows and Mod+Shift+Arrows stay on the current screen even at the end of the strip;
# the other screen is reached explicitly with Mod+Ctrl+Arrows (focus) and Mod+Alt+Arrows (move).
[navigation]
edge_hop = false

# A new window opens on the screen that has the focus (niri); "placed" keeps the screen Windows
# chose. Windows coming back from minimize keep their own screen.
[focus]
new_window_monitor = "focused"

# Key bindings. Without this section the keymap uses its built-in table (binds.toml next to this
# file: Mod+Arrows focus, Mod+Shift+Arrows move, Mod+1..9 workspaces, Mod+R widths, Mod+T Alacritty,
# Mod+Space launcher, Mod+Shift+/ help, ...). Entries here are laid over it in niri's spelling: the
# same chord replaces the default, a new chord is added, "none" unbinds one. Saved changes apply
# within a few seconds; `flow query binds` shows the result, `flow config check` names mistakes.
# The full grammar and action table are in the user guide (Config Reference, [binds]).
[binds]
# "Mod+Shift+R" = "switch-preset-column-width-back"
# "Mod+Q" = "none"
# "Mod+Return" = { spawn = ["alacritty"] }
# "Mod+Shift+Return" = { spawn = ["wt", "-p", "PowerShell"], admin = true, help = "admin shell" }

# The X11-style selection buffer: what you highlight with the mouse is kept apart from the clipboard
# and a middle click on a text field or a terminal pastes it (the clipboard is put back). Off by
# default; applies when this file is saved. Limits (Alacritty highlights are not seen, ...) are in
# README.md next to this file, *Selection buffer*.
# [keymap]
# selection_buffer = true

# Programs to run once FlowWM is up, each as ["program", "arg", ...] (looked up like a spawn bind).
# [startup]
# spawn = [["alacritty"]]

# The floating layer, as in niri: floating windows (Mod+V) and windows your rules ignore (dialogs,
# popups) always sit above the tiled windows, even when a tile has the focus, so a dialog is never
# hidden behind the strip. They go back to the normal z-order when tiled, on `tiling off`
# (Mod+Ctrl+T) and when the daemon stops; a window that was "always on top" by itself keeps that.
[floating]
always_on_top = true
